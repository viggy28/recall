{
  "name": "recall-pi",
  "version": "0.5.0",
  "type": "module",
  "description": "A local knowledge base built from Claude Code, Codex, OpenCode, and Pi conversations",
  "repository": {
    "type": "git",
    "url": "https://github.com/viggy28/recall"
  },
  "bugs": {
    "url": "https://github.com/viggy28/recall/issues"
  },
  "homepage": "https://github.com/viggy28/recall#readme",
  "keywords": [
    "pi-package",
    "pi-extension",
    "session-search",
    "recall",
    "opencode"
  ],
  "license": "MIT",
  "files": [
    "recall.py",
    "recall_core/**/*.py",
    "pyproject.toml",
    "requirements-semantic.txt",
    "extensions/recall/index.ts",
    "extensions/recall/source-collector.ts",
    "docs/*.md",
    "docs/*.svg",
    "docs/recall-demo.gif",
    "docs/recall-demo.tape",
    "README.md"
  ],
  "scripts": {
    "test:collector": "node --experimental-strip-types --test extensions/recall/source-collector.test.ts extensions/recall/source-create.test.ts",
    "typecheck": "tsc --project tsconfig.recall.json"
  },
  "pi": {
    "extensions": [
      "./extensions/recall/index.ts"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-agent-core": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "typescript": "^7.0.2"
  }
}
