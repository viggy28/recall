---
const year = new Date().getFullYear();
---

<footer class="border-t-[1.5px] border-ink">
  <div class="mx-auto max-w-[1200px] px-6 pb-12 pt-16 sm:px-10">
    <div class="grid gap-12 text-sm md:grid-cols-[2fr_1fr_1fr]">
      <div class="grid max-w-[40ch] content-start gap-3.5">
        <div class="font-mono text-[0.9375rem] font-medium tracking-tight">recall<span class="text-accent">_</span></div>
        <p class="text-sm leading-relaxed text-muted">
          A local knowledge base built from your coding-agent sessions. Search,
          resume, and build on everything you have already done — nothing leaves
          your machine.
        </p>
      </div>

      <div>
        <h3 class="font-mono text-[0.6875rem] uppercase tracking-[0.12em] text-faint">Product</h3>
        <ul class="mt-4 grid gap-3 text-muted">
          <li><a href="/docs/usage">Usage</a></li>
          <li><a href="/docs/development">Development</a></li>
          <li><a href="/docs/releases">Releases</a></li>
          <li><a href="/blog">Blog</a></li>
        </ul>
      </div>

      <div>
        <h3 class="font-mono text-[0.6875rem] uppercase tracking-[0.12em] text-faint">Open source</h3>
        <ul class="mt-4 grid gap-3 text-muted">
          <li>
            <a href="https://github.com/viggy28/recall" target="_blank" rel="noopener noreferrer">GitHub</a>
          </li>
          <li>
            <a href="https://www.npmjs.com/package/recall-pi" target="_blank" rel="noopener noreferrer">npm package</a>
          </li>
          <li>
            <a href="https://github.com/viggy28/recall/issues" target="_blank" rel="noopener noreferrer">Issues</a>
          </li>
          <li>
            <a href="https://github.com/viggy28/recall/blob/main/CHANGELOG.md" target="_blank" rel="noopener noreferrer">Changelog</a>
          </li>
        </ul>
      </div>
    </div>

    <div class="mt-14 flex flex-wrap justify-between gap-4 font-mono text-xs text-faint">
      <span>&copy; {year} Recall. MIT licensed.</span>
      <span>askrecall.dev</span>
    </div>
  </div>
</footer>
