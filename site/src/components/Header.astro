---
const nav = [
  { href: '/docs', label: 'Docs' },
  { href: '/blog', label: 'Blog' },
  { href: 'https://github.com/viggy28/recall', label: 'GitHub', external: true },
];
---

<header
  class="sticky top-0 z-50 border-b border-neutral-200 bg-white/80 backdrop-blur"
>
  <div class="mx-auto flex h-16 max-w-6xl items-center justify-between px-4 sm:px-6">
    <a href="/" class="flex items-center gap-2" aria-label="Recall home">
      <svg width="26" height="26" viewBox="0 0 32 32" fill="none" aria-hidden="true">
        <rect width="32" height="32" rx="7" fill="#0a0a0a" />
        <path
          d="M12 9 L21 16 L12 23"
          stroke="#fff"
          stroke-width="3"
          stroke-linecap="round"
          stroke-linejoin="round"
        />
      </svg>
      <span class="text-[15px] font-semibold tracking-tight">Recall</span>
    </a>

    <nav class="hidden items-center gap-1 md:flex">
      {nav.map((item) => (
        <a
          href={item.href}
          class="rounded-md px-3 py-2 text-sm font-medium text-neutral-600 transition-colors hover:bg-neutral-100 hover:text-neutral-900"
          {...(item.external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
        >
          {item.label}
        </a>
      ))}
      <a
        href="/docs/usage"
        class="ml-3 rounded-md bg-neutral-900 px-3.5 py-2 text-sm font-medium text-white transition-colors hover:bg-neutral-700"
      >
        Install
      </a>
    </nav>

    <!-- Mobile menu -->
    <div class="md:hidden">
      <button
        id="menu-toggle"
        type="button"
        class="rounded-md p-2 text-neutral-600 hover:bg-neutral-100"
        aria-label="Toggle menu"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <svg id="menu-icon-open" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" aria-hidden="true">
          <path d="M4 7h16M4 12h16M4 17h16" />
        </svg>
        <svg id="menu-icon-close" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" class="hidden" aria-hidden="true">
          <path d="M6 6l12 12M18 6L6 18" />
        </svg>
      </button>
    </div>
  </div>

  <div id="mobile-menu" class="hidden border-t border-neutral-200 bg-white md:hidden">
    <nav class="flex flex-col gap-1 px-4 py-3">
      {nav.map((item) => (
        <a
          href={item.href}
          class="rounded-md px-3 py-2 text-sm font-medium text-neutral-700 hover:bg-neutral-100"
          {...(item.external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
        >
          {item.label}
        </a>
      ))}
      <a
        href="/docs/usage"
        class="mt-1 rounded-md bg-neutral-900 px-3 py-2 text-center text-sm font-medium text-white"
      >
        Install
      </a>
    </nav>
  </div>
</header>

<script>
  const toggle = document.getElementById('menu-toggle');
  const menu = document.getElementById('mobile-menu');
  const iconOpen = document.getElementById('menu-icon-open');
  const iconClose = document.getElementById('menu-icon-close');

  toggle?.addEventListener('click', () => {
    const isOpen = !menu?.classList.contains('hidden');
    menu?.classList.toggle('hidden', isOpen);
    iconOpen?.classList.toggle('hidden', !isOpen);
    iconClose?.classList.toggle('hidden', isOpen);
    toggle?.setAttribute('aria-expanded', String(!isOpen));
  });
</script>
