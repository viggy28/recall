---
interface Props {
  title?: string;
  class?: string;
}

const { title = 'terminal', class: className } = Astro.props;
---

<div
  class:list={[
    'overflow-hidden rounded-xl border border-neutral-200 bg-neutral-950 text-neutral-100 shadow-[0_1px_2px_rgba(0,0,0,0.08),0_8px_24px_-12px_rgba(0,0,0,0.2)]',
    className,
  ]}
>
  <div class="flex items-center gap-2 border-b border-white/10 px-4 py-3">
    <span class="h-3 w-3 rounded-full bg-neutral-700" />
    <span class="h-3 w-3 rounded-full bg-neutral-700" />
    <span class="h-3 w-3 rounded-full bg-neutral-700" />
    <span class="ml-2 font-mono text-xs text-neutral-500">{title}</span>
  </div>
  <div class="overflow-x-auto p-4 font-mono text-sm leading-relaxed">
    <slot />
  </div>
</div>
