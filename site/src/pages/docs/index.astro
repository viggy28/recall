---
import Base from '../../layouts/Base.astro';
import { docsMeta } from '../../lib/docs-meta';
---

<Base
  title="Documentation — Recall"
  description="Installation, usage, architecture, and release documentation for Recall, a local knowledge base for coding agents."
>
  <div class="mx-auto max-w-[1200px] px-6 py-16 sm:px-10 lg:py-20">
    <div class="max-w-2xl">
      <p class="eyebrow">docs</p>
      <h1 class="mt-3 text-[clamp(2.375rem,5vw,3.75rem)] font-[750] leading-[1.02] tracking-[-0.03em] text-ink">
        Documentation
      </h1>
      <p class="mt-5 text-lg leading-relaxed text-muted">
        Everything you need to install, use, and contribute to Recall. These
        pages are generated from the same Markdown files in the{" "}
        <a href="https://github.com/viggy28/recall/tree/main/docs" target="_blank" rel="noopener noreferrer" class="text-accent underline decoration-[var(--accent-dash)] underline-offset-4">
          repository
        </a>
        , so the website and the code stay in sync.
      </p>
    </div>

    <div class="mt-14 grid gap-px border border-line bg-line md:grid-cols-3">
      {docsMeta.map((doc, i) => (
        <a
          href={`/docs/${doc.slug}`}
          class="group flex flex-col bg-panel p-8 transition-colors hover:bg-[var(--accent-wash)]"
        >
          <p class="font-mono text-xs uppercase tracking-[0.14em] text-faint">{String(i + 1).padStart(2, '0')}</p>
          <h2 class="mt-4 text-lg font-bold tracking-tight text-ink group-hover:text-accent">
            {doc.title}
          </h2>
          <p class="mt-2 flex-1 text-sm leading-relaxed text-muted">
            {doc.description}
          </p>
          <p class="mt-6 font-mono text-xs text-accent">Read →</p>
        </a>
      ))}
    </div>
  </div>
</Base>
