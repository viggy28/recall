---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const { title, description, pubDate, author, tags } = entry.data;
---

<Base title={`${title} — Recall Blog`} description={description}>
  <article class="mx-auto max-w-3xl px-6 py-16 sm:px-10 lg:py-20">
    <p class="font-mono text-[0.6875rem] tracking-[0.14em] text-faint">
      {pubDate.toISOString().slice(0, 10)} · {author}
    </p>
    <h1 class="mt-3 text-[clamp(2.125rem,4.4vw,3.375rem)] font-[750] leading-[1.03] tracking-[-0.03em] text-ink">
      {title}
    </h1>
    <p class="mt-5 text-lg leading-relaxed text-muted">{description}</p>

    {tags.length > 0 && (
      <div class="mt-7 flex flex-wrap gap-2">
        {tags.map((tag) => (
          <span class="chip text-muted">
            {tag}
          </span>
        ))}
      </div>
    )}

    <div class="prose-docs mt-10 border-t border-line-soft pt-8">
      <Content />
    </div>

    <p class="mt-14 border-t-[1.5px] border-ink pt-6 font-mono text-sm">
      <a href="/blog" class="text-accent">
        ← Back to blog
      </a>
    </p>
  </article>
</Base>
