---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<Base
  title="Blog — Recall"
  description="Notes on how Recall is built, and why it works the way it does."
>
  <div class="mx-auto max-w-3xl px-6 py-16 sm:px-10 lg:py-20">
    <p class="eyebrow">blog</p>
    <h1 class="mt-3 text-[clamp(2.375rem,5vw,3.75rem)] font-[750] leading-[1.02] tracking-[-0.03em] text-ink">
      Blog
    </h1>
    <p class="mt-5 text-lg leading-relaxed text-muted">
      Notes on how Recall is built, and why it works the way it does.
    </p>

    {posts.length > 0 ? (
      <div class="mt-14 border-y border-line">
        {posts.map((post) => (
          <a href={`/blog/${post.id}`} class="group block border-b border-line-soft py-7 last:border-b-0">
            <p class="font-mono text-[0.6875rem] uppercase tracking-[0.14em] text-faint">
              {post.data.pubDate.toISOString().slice(0, 10)}
            </p>
            <h2 class="mt-2 text-xl font-bold tracking-tight text-ink group-hover:text-accent">
              {post.data.title}
            </h2>
            <p class="mt-2 text-muted">{post.data.description}</p>
          </a>
        ))}
      </div>
    ) : (
      <div class="mt-14 border border-dashed border-line bg-panel p-10 text-center">
        <p class="font-mono text-sm uppercase tracking-[0.14em] text-accent">Coming soon</p>
        <p class="mt-3 text-muted">
          We're writing the first posts. Check back shortly — or follow along
          on <a href="https://github.com/viggy28/recall" target="_blank" rel="noopener noreferrer" class="text-accent underline decoration-[var(--accent-dash)] underline-offset-4">GitHub</a>.
        </p>
      </div>
    )}
  </div>
</Base>
