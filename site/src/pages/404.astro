---
import Base from '../layouts/Base.astro';
---

<Base title="Page not found — Recall" description="The page you are looking for could not be found.">
  <div class="mx-auto flex max-w-3xl flex-col items-center px-6 py-24 text-center sm:px-10">
    <p class="font-mono text-[clamp(4rem,12vw,7.5rem)] font-medium leading-none tracking-[-0.04em] text-faint">404</p>
    <h1 class="mt-6 text-[clamp(1.625rem,3.4vw,2.5rem)] font-[750] leading-[1.05] tracking-[-0.03em] text-ink">
      This page doesn't exist.
    </h1>
    <p class="mt-4 max-w-md leading-relaxed text-muted">
      The page you're looking for was moved, deleted, or never existed in the
      first place.
    </p>
    <div class="mt-10 flex flex-wrap justify-center gap-3">
      <a href="/" class="bg-btn-bg px-6 py-3.5 font-mono text-[0.8125rem] text-btn-fg transition-colors hover:bg-accent hover:text-on-accent">
        Go home
      </a>
      <a href="/docs" class="hover-accent border border-line px-6 py-3.5 font-mono text-[0.8125rem]">
        Read the docs
      </a>
    </div>
  </div>
</Base>
