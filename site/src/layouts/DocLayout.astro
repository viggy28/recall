---
import { docsMeta } from '../lib/docs-meta';

interface Props {
  title: string;
  description?: string;
  currentSlug: string;
  githubPath: string;
}

const { title, description, currentSlug, githubPath } = Astro.props;
const repoBase = 'https://github.com/viggy28/recall/blob/main/docs';
---

<div class="mx-auto max-w-[1200px] px-6 py-12 sm:px-10 lg:py-16">
  <div class="lg:grid lg:grid-cols-[240px_1fr] lg:gap-16">
    <aside class="mb-12 lg:mb-0">
      <div class="lg:sticky lg:top-24">
        <p class="font-mono text-[0.6875rem] uppercase tracking-[0.14em] text-faint">
          Documentation
        </p>
        <nav class="mt-4 flex flex-col border-t border-line-soft">
          {docsMeta.map((doc) => {
            const active = doc.slug === currentSlug;
            return (
              <a
                href={`/docs/${doc.slug}`}
                class:list={[
                  'border-b border-line-soft px-3 py-2.5 text-sm transition-colors',
                  active
                    ? 'bg-ink font-medium text-bg'
                    : 'text-muted hover:bg-[var(--accent-wash)] hover:text-accent',
                ]}
                aria-current={active ? 'page' : undefined}
              >
                {doc.title}
              </a>
            );
          })}
        </nav>

        <div class="paper-card mt-8 p-4">
          <p class="font-mono text-[0.6875rem] tracking-[0.14em] text-accent">Get started</p>
          <p class="mt-2 text-xs leading-relaxed text-muted">
            Install the Pi extension or run the standalone CLI.
          </p>
          <a
            href="/docs/usage"
            class="mt-3 inline-block font-mono text-xs text-accent"
          >
            Read the usage guide →
          </a>
        </div>
      </div>
    </aside>

    <article class="min-w-0">
      <p class="font-mono text-[0.6875rem] tracking-[0.14em] text-faint">docs / {currentSlug}</p>
      <h1 class="mt-3 text-[clamp(1.875rem,3.6vw,2.75rem)] font-[750] leading-[1.05] tracking-[-0.03em] text-ink">
        {title}
      </h1>
      {description && (
        <p class="mt-3 max-w-2xl text-lg leading-relaxed text-muted">{description}</p>
      )}

      <div class="prose-docs mt-10 max-w-3xl border-t border-line-soft pt-8">
        <slot />
      </div>

      <a
        href={`${repoBase}/${githubPath}`}
        target="_blank"
        rel="noopener noreferrer"
        class="chip mt-12 inline-flex items-center gap-2 text-muted transition-colors hover:border-accent hover:text-accent"
      >
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M7 17L17 7M8 7h9v9" />
        </svg>
        Edit this page on GitHub
      </a>
    </article>
  </div>
</div>
